# SQLite for local. Production should use PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:pass@localhost:5432/droomop2"
DATABASE_URL="file:./dev.db"

SESSION_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3001"

# Local defaults (change in production)
ADMIN_EMAIL="admin@droomop2.local"
ADMIN_PASSWORD="admin123"

# Must stay "true" until legal approval
DISABLED_PENDING_LEGAL_APPROVAL="true"
PRIZE_FEATURE_ENABLED="false"
MULTI_LEVEL_REFERRALS="false"

# Mollie TEST key only (test_...). Never put a live key in this repo.
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_URL=""
