# Production Combell MySQL (set the real URL in Combell environment, not in git):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

SESSION_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3001"

# Local defaults (change in production)
ADMIN_EMAIL="admin@myurusdream.local"
ADMIN_PASSWORD="admin123"

# Must stay "true" until legal approval
DISABLED_PENDING_LEGAL_APPROVAL="true"
PRIZE_FEATURE_ENABLED="false"
MULTI_LEVEL_REFERRALS="false"

# Mollie TEST key only (test_...). Never put a live key in this repo.
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_URL=""

# E-mail via Brevo (zelfde account/werkwijze als ModelPort).
# Host smtp-relay.brevo.com, poort 587. Wachtwoord = SMTP-sleutel (xsmtpsib-…), niet de mailbox.
# FROM moet in Brevo als afzender staan: info@myurusdream.be
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="myurusdream.be <info@myurusdream.be>"
